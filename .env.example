# Quicknode API Key (from Quicknode dashboard)
QN_API_KEY=""

# Stream Security Token (from Stream creation response)
QN_STREAM_SECURITY_TOKEN=""

# Quicknode EVM Endpoint URL (optional, for ENS resolution)
QN_EVM_ENDPOINT=""

# Database URL (SQLite)
DATABASE_URL="file:./dev.db"

# App URL (for webhook destination - use ngrok for local dev)
APP_URL="https://abc123.ngrok-free.app"

# App name
NEXT_PUBLIC_APP_NAME="HyperCore Order Monitor"

# Admin API Key (for protecting admin endpoints in production)
# Generate a secure random string and set this in production
ADMIN_API_KEY=""
